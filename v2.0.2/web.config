<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
	<rewrite>
	
	  <rules>
		<!-- Servir archivos estaticos de private_videos directamente (sin pasar por PHP) -->
		<rule name="Allow Private Videos" stopProcessing="true">
		  <match url="^private_videos/.*$" ignoreCase="true" />
		  <action type="None" />
		</rule>

		<rule name="Clean URLs" stopProcessing="true">
		  <match url="^(.*)$"  />
		  <conditions>
				 <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
				 <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
				 <add input="{URL}" pattern="^/favicon.ico$" ignoreCase="false" negate="true" />
			 </conditions>
		  <action type="Rewrite" url="index.php?q={R:1}"  />
		</rule>
	  </rules>
	</rewrite>
    
    <security>
      <requestFiltering allowDoubleEscaping="true" />
    </security>

	<!-- Default docs -->
	<defaultDocument>
	  <files>
		<clear />
		<add value="index.php" />
		<add value="index.html" />
	  </files>
	</defaultDocument>

	<!-- Error display while debug -->
	<httpErrors errorMode="Detailed" />
	<staticContent>
			<mimeMap fileExtension=".wasm" mimeType="application/wasm" />
		</staticContent>
  </system.webServer>
</configuration>